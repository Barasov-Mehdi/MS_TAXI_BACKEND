# Nümunə konfiqurasiya. Real dəyərləri .env faylına (git-ə düşmür) və ya Heroku Config Vars-a yazın.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/taxi
REDIS_URL=disabled
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-access
JWT_REFRESH_SECRET=change-me-at-least-32-characters-long-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=*

# Firebase service account (base64) — push bildirişləri üçün
FIREBASE_SERVICE_ACCOUNT_B64=

# OTP / SMS (1sms.az). Boşdursa və NODE_ENV=production deyilsə kod konsola yazılır və devCode qaytarılır.
SMS_API_KEY=
SMS_SENDER_NAME=1sms.az
# OTP_SECRET=
